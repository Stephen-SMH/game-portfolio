---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { games } from '../data/games';
import { profile } from '../data/profile';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const tech = [...new Set(games.flatMap((g) => g.tech))];
const sections = ['intro', 'about', 'games', 'toolkit', 'contact'];
const words = profile.statement.split(' ');
const stats = [
  [games.length, 'games built'],
  [games.filter((g) => g.play).length, 'playable online'],
  [profile.jams, 'game jam'],
  [tech.length, 'technologies used'],
];
---
<Base
  title={`${profile.first} — Game Portfolio`}
  description="Game portfolio: Werewolf, The Knock and more. Play them in the browser."
>
  <!-- Scroll progress -->
  <div class="bar" id="bar">
    <span class="pct" id="pct">0%</span>
    <div class="track" aria-hidden="true">
      <div class="labels base">{sections.map((s) => <span data-s={s}>{`{${s}}`}</span>)}<span class="caret">_</span></div>
      <div class="fill"><div class="labels">{sections.map((s) => <span>{`{${s}}`}</span>)}<span class="caret">_</span></div></div>
      <span class="left" id="left">100% remaining</span>
    </div>
    <button class="chev" id="chev" aria-label="Collapse progress bar" aria-expanded="true">
      <svg viewBox="0 0 24 24"><path d="m6 9 6 6 6-6" /></svg>
    </button>
  </div>

  <main>
    <!-- INTRO -->
    <section class="intro" id="intro">
      <div class="wrap intro-grid">
        <div>
          <span class="eyebrow">Game developer</span>
          <h1 class="mega">
            <span class="ln"><span style="--i:0">Hey,</span></span>
            <span class="ln"><span style="--i:1">I'm <em>{profile.first}.</em></span></span>
          </h1>
          <p class="lead rise" style="--i:3">{profile.tagline}</p>
          <div class="cta rise" style="--i:4">
            <a class="btn" href="#games"><span>Play my games</span><i class="circ"><Icon name="arrow" /></i></a>
            <a class="btn ghost" href={profile.engineerSite} target="_blank" rel="noopener"><span>Engineering portfolio</span><i class="circ"><Icon name="arrow" /></i></a>
          </div>
        </div>
        <div class="portrait rise" style="--i:2">
          <div class="frame"><img src={profile.avatar} alt="Stephen" width="480" height="480" /></div>
        </div>
      </div>
      <a class="scroll-hint" href="#about" aria-label="Scroll down"><span></span></a>
    </section>

    <!-- ABOUT -->
    <section class="about" id="about">
      <div class="wrap">
        <span class="eyebrow">About me</span>
        <p class="statement" id="statement">
          {words.map((w) => <><span class="w">{w}</span>{' '}</>)}
        </p>
        <div class="stats">
          {stats.map(([n, l]) => (
            <div class="stat reveal"><b data-count={n}>{n}</b><span>{l}</span></div>
          ))}
        </div>
      </div>
    </section>

    <!-- TOOLKIT -->
    <section class="skills" id="toolkit">
      <div class="wrap">
        <span class="eyebrow">Toolkit</span>
        <h2 class="h2 reveal">What my games are made with.</h2>
        <div class="pills reveal">
          {tech.map((t) => <span class="pill">{t}</span>)}
        </div>
      </div>
      <div class="marquee" aria-hidden="true">
        <div>{[0, 1].map(() => tech.map((t) => <span>{t}</span>))}</div>
      </div>
    </section>

    <!-- GAMES -->
    <section class="games" id="games">
      <div class="wrap">
        <span class="eyebrow">Games</span>
        <h2 class="h2 reveal">Things you can actually play.</h2>
      </div>

      {games.map((g, i) => (
        <article class={`showcase wrap${i % 2 ? ' flip' : ''}`}>
          <div class="poster-col">
            <div class="frame poster-frame">
              <div class="poster" style={`--from:${g.from};--to:${g.to}`}>
                <h3>{g.headline}</h3>
                {g.shot
                  ? <div class="device"><img src={`${base}/${g.shot}`} alt={`${g.title} screenshot`} loading="lazy" width="430" height="900" /></div>
                  : <div class="ghost-type" aria-hidden="true">{g.title}</div>}
              </div>
            </div>
          </div>
          <div class="detail">
            <div class="detail-head">
              <span class="tick"></span>
              <h3>{g.title}</h3>
              <a class="check" href={g.play ?? g.repo} target="_blank" rel="noopener">{g.play ? 'Play' : 'Check out'} <Icon name="arrow" /></a>
            </div>
            <p class="desc reveal">{g.blurb}</p>
            <ul class="points">
              {g.points.map((p, j) => (
                <li class="reveal" style={`--d:${j * 80}ms`}>
                  <svg class="spark" viewBox="0 0 24 24"><path d="M12 2c.6 5.600 3.400 8.400 10 10-6.600 1.600-9.400 4.400-10 10-.6-5.600-3.400-8.400-10-10 6.600-1.600 9.400-4.400 10-10Z" /></svg>
                  <span>{p}</span>
                </li>
              ))}
            </ul>
            <div class="techs reveal">
              {g.tech.map((t) => <span class="tech">{t}</span>)}
              <a class="tech src" href={g.repo} target="_blank" rel="noopener"><Icon name="code" />Source</a>
            </div>
          </div>
        </article>
      ))}
    </section>

    <!-- CONTACT -->
    <section class="contact" id="contact">
      <div class="wrap">
        <span class="eyebrow">Contact</span>
        <h2 class="mega small reveal">Let's make<br />a game.</h2>
        <a class="mail reveal" href={`mailto:${profile.email}`}>{profile.email}<i class="circ"><Icon name="arrow" /></i></a>
        <footer class="foot">Built with Astro · <a href={profile.github} target="_blank" rel="noopener">GitHub</a> · <a href={profile.engineerSite} target="_blank" rel="noopener">Software engineering portfolio</a></footer>
      </div>
    </section>
  </main>

  <!-- Floating prompt -->
  <div class="fab">
    <a class="fab-bubble" href="#about"><span>👋</span>Know more about me</a>
    <a class="fab-btn" href="#contact" aria-label="Contact me">
      <svg viewBox="0 0 24 24"><path d="M5 5.500h14a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2h-7l-5 3.500v-3.500H5a2 2 0 0 1-2-2v-8a2 2 0 0 1 2-2Z" /></svg>
    </a>
  </div>

  <script>
    const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

    // ---- Scroll progress bar ----
    const bar = $('bar');
    const pct = $('pct');
    const left = $('left');
    let ticking = false;
    function progress() {
      ticking = false;
      const max = document.documentElement.scrollHeight - innerHeight;
      const p = max > 0 ? Math.min(100, Math.max(0, (scrollY / max) * 100)) : 0;
      const r = Math.round(p);
      bar.style.setProperty('--p', `${p}%`);
      pct.textContent = `${r}%`;
      left.textContent = `${100 - r}% remaining`;
    }
    addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(progress);
        }
      },
      { passive: true },
    );
    addEventListener('resize', progress);
    progress();

    $('chev').addEventListener('click', (e) => {
      const min = bar.classList.toggle('min');
      (e.currentTarget as HTMLElement).setAttribute('aria-expanded', String(!min));
    });

    // Highlight the label of the section in view
    const labels = [...document.querySelectorAll<HTMLElement>('.labels.base [data-s]')];
    const secIO = new IntersectionObserver(
      (entries) =>
        entries.forEach((en) => {
          if (en.isIntersecting) {
            const id = (en.target as HTMLElement).id;
            labels.forEach((l) => l.classList.toggle('on', l.dataset.s === id));
          }
        }),
      { rootMargin: '-45% 0px -50% 0px' },
    );
    document.querySelectorAll('main > section').forEach((s) => secIO.observe(s));

    // ---- Reveal on scroll ----
    const io = new IntersectionObserver(
      (entries) =>
        entries.forEach((en) => {
          if (en.isIntersecting) {
            en.target.classList.add('in');
            io.unobserve(en.target);
          }
        }),
      { threshold: 0.12 },
    );
    document.querySelectorAll('.reveal').forEach((el) => io.observe(el));

    // ---- About statement: words light up as you scroll ----
    const words = [...document.querySelectorAll<HTMLElement>('.w')];
    const wordIO = new IntersectionObserver(
      (entries) =>
        entries.forEach((en) => {
          const above = en.boundingClientRect.top < innerHeight * 0.62;
          en.target.classList.toggle('on', en.isIntersecting ? above : en.boundingClientRect.top < 0);
        }),
      { rootMargin: '0px 0px -38% 0px', threshold: [0, 1] },
    );
    words.forEach((w) => wordIO.observe(w));
    if (reduce) words.forEach((w) => w.classList.add('on'));

    // ---- Count-up stats ----
    const countIO = new IntersectionObserver(
      (entries) =>
        entries.forEach((en) => {
          if (!en.isIntersecting) return;
          countIO.unobserve(en.target);
          const el = en.target as HTMLElement;
          const to = Number(el.dataset.count);
          if (reduce || !to) return;
          const t0 = performance.now();
          const tick = (t: number) => {
            const k = Math.min(1, (t - t0) / 1400);
            el.textContent = String(Math.round(to * (1 - Math.pow(1 - k, 4))));
            if (k < 1) requestAnimationFrame(tick);
          };
          requestAnimationFrame(tick);
        }),
      { threshold: 0.6 },
    );
    document.querySelectorAll('[data-count]').forEach((el) => countIO.observe(el));
  </script>
</Base>
